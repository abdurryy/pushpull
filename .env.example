# Firebase web config for local development. Copy to .env.local and fill in from the Firebase console
# (Project settings > Your apps). .env.local is git-ignored; never commit real values.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
