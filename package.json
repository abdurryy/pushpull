{
  "name": "pushpull",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "serve": "vite preview",
    "shots": "node .agents/skills/ui-design/scripts/screenshot.mjs",
    "shots:controller": "node .agents/skills/ui-design/scripts/screenshot.mjs \"#/play/controller\" --click=\"Enter controller\" --name=controller --sizes=phone-sideways",
    "frames": "node .agents/skills/game-feel/scripts/capture-frames.mjs",
    "frames:crash": "node .agents/skills/game-feel/scripts/capture-frames.mjs \"#/components\" --click=Crash --selector=.gallery-board --name=crash",
    "sounds": "node .agents/skills/game-audio/scripts/render-audio.mjs"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.3.0",
    "playwright": "1.65.1",
    "vite": "^8.3.8"
  },
  "dependencies": {
    "firebase": "^13.4.0",
    "mobx": "^7.1.7",
    "mobx-react-lite": "^5.1.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-qr-code": "^2.2.0",
    "react-router-dom": "^7.18.7"
  },
  "overrides": {
    "@firebase/firestore": {
      "@grpc/grpc-js": "^1.14.7"
    }
  }
}
