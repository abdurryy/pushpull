{
  "rules": {
    "rooms": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && data.exists() && !newData.exists() && (data.child('meta/hostUid').val() == auth.uid || data.child('meta/expiresAt').val() <= now)",
        "meta": {
          ".write": "auth != null && $code.matches(/^[ABCDEFGHJKMNPQRSTUVWXYZ23456789]{4}$/) && !data.exists() && newData.child('hostUid').val() == auth.uid",
          ".validate": "newData.hasChildren(['hostUid', 'expiresAt'])",
          "hostUid": { ".validate": "newData.isString()" },
          "expiresAt": { ".validate": "newData.isNumber() && newData.val() > now && newData.val() <= now + 86400000" },
          "$other": { ".validate": false }
        },
        "hostOnline": {
          ".write": "auth != null && root.child('rooms').child($code).child('meta/hostUid').val() == auth.uid && root.child('rooms').child($code).child('meta/expiresAt').val() > now",
          ".validate": "newData.isBoolean()"
        },
        "seats": {
          "$seat": {
            ".write": "auth != null && $seat.matches(/^s[1-4]$/) && root.child('rooms').child($code).child('meta/expiresAt').val() > now && ((!data.exists() && newData.val() == auth.uid && newData.parent().parent().child('players').child(auth.uid).child('seat').val() == $seat) || (data.val() == auth.uid && !newData.exists() && !newData.parent().parent().child('players').child(auth.uid).exists()))"
          }
        },
        "players": {
          "$uid": {
            ".write": "auth != null && auth.uid == $uid && root.child('rooms').child($code).child('meta/expiresAt').val() > now && (newData.exists() || !newData.parent().parent().child('seats').child(data.child('seat').val()).exists())",
            ".validate": "newData.hasChildren(['name', 'side', 'seat'])",
            "seat": { ".validate": "newData.isString() && newData.val().matches(/^s[1-4]$/) && (!data.exists() || data.val() == newData.val()) && newData.parent().parent().parent().child('seats').child(newData.val()).val() == $uid" },
            "name": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 80" },
            "side": { ".validate": "newData.val() == 'a' || newData.val() == 'b' || newData.val() == 'center'" },
            "$other": { ".validate": false }
          }
        },
        "inputs": {
          "$uid": {
            ".write": "auth != null && auth.uid == $uid && root.child('rooms').child($code).child('meta/expiresAt').val() > now && (!newData.exists() || newData.parent().parent().child('players').child($uid).exists())",
            ".validate": "newData.hasChildren(['stick'])",
            "stick": { ".validate": "newData.val() == 'idle' || newData.val() == 'up' || newData.val() == 'down' || newData.val() == 'left' || newData.val() == 'right'" },
            "button": { ".validate": "newData.val() == 'dash' || newData.val() == 'ping' || newData.val() == 'shed' || newData.val() == 'hold'" },
            "buttonAt": { ".validate": "newData.isNumber() && newData.val() <= now" },
            "$other": { ".validate": false }
          }
        }
      }
    }
  }
}
